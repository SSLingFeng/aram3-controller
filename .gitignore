# ---- 不要提交到 GitHub（隐私 / 本机环境）----

# 运行数据（用户、实例、RCON、日志）
data/
backend/data/
**/data/
*.db
*.db-shm
*.db-wal
*.sqlite

# 日志与诊断
logs/
*.log
*.jfr
*.dump
*.dumpstream

# 密钥与本地密钥文件（如自定义）
*.pem
*.key
!**/src/test/resources/**/*.key
.env.local
.env.*.local

# 构建产物
target/
backend/target/
frontend/dist/
frontend/node_modules/
backend/src/main/resources/static/assets/
backend/src/main/resources/static/index.html
!frontend/public/**

# IDE（保留 runConfigurations 也可；workspace 含本机路径）
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/dataSources/
.idea/**/dataSources.local.xml
backend/.idea/workspace.xml
*.iml

# 系统
.DS_Store
Thumbs.db
desktop.ini

# 本地打包脚本以外的临时文件
*.tmp
*.bak
*.swp

# 测试/示例中含真实服务器信息时请勿提交
